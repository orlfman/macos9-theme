# Generated by plasma/make-plasma.py from colors/Platinum.colors: the
# selection is the menu highlight here (Plasma only).
# Platinum: KDE color scheme measured from Mac OS 9.2.2 (Apple platinum
# appearance, Purple highlight, Lavender variation). Every color below comes
# from docs/REFERENCE.md unless marked "not measured".
#
# Measured: window and button face #DDDDDD, title bar face #CCCCCC (active)
# and #DDDDDD (inactive), views #FFFFFF, text #000000, disabled text #777777,
# text selection #CCCCFF with black text, focus ring #6666CC, links #0000FF,
# help balloons white with black text.
#
# Not representable here and drawn by the C++ style and decoration instead:
# menu highlight #333399 with white text (KDE uses one Selection group for
# both views and menus; views won), bevels, pinstripes, scroll bars.
#
# Mac OS 9 has no semantic red/orange/green text, no visited-link color and
# no dark "complementary" surfaces; those keys are not measured, picked to be
# plain and readable.

[ColorEffects:Disabled]
# Disabled text fades toward its background: black on #DDDDDD gives #777777
# (0.54 * 0xDD = 0x77), the measured disabled text. Backgrounds unchanged.
